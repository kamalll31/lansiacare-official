{
  "version": 2,
  "builds": [
    {
      "src": "backend/run.py",
      "use": "@vercel/python"
    },
    {
      "src": "admin_web/build/web/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/run.py"
    },
    {
      "source": "/setup-db-darurat",
      "destination": "backend/run.py"
    },
    {
      "source": "/((?!api|setup-db-darurat).*)",
      "destination": "admin_web/build/web/index.html"
    }
  ]
} //